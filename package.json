{
  "name": "arc-to-chrome",
  "version": "0.1.0",
  "description": "Export Arc browser spaces, pinned tabs, favorites and extensions into a bookmarks file Chrome can import",
  "type": "module",
  "bin": {
    "arc-to-chrome": "bin/arc-to-chrome.js"
  },
  "files": [
    "bin",
    "src/convert.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "arc",
    "chrome",
    "bookmarks",
    "migration",
    "browser"
  ],
  "license": "MIT",
  "author": "Daksh Vasudev (https://github.com/dakshvasudev)",
  "homepage": "https://github.com/dakshvasudev/arc-to-chrome#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dakshvasudev/arc-to-chrome.git"
  },
  "bugs": {
    "url": "https://github.com/dakshvasudev/arc-to-chrome/issues"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
