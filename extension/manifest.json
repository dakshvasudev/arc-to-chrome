{
  "manifest_version": 3,
  "name": "Live Folders for Chrome",
  "short_name": "Live Folders",
  "version": "0.1.0",
  "description": "Arc-style live folders on Chrome's bookmarks bar. Your open GitHub pull requests, always up to date.",
  "homepage_url": "https://arc-to-chrome.vercel.app",
  "permissions": ["bookmarks", "storage", "alarms"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Live Folders",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
